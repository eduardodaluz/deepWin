#!/usr/bin/env bash
# Executa o Claude Code pela API da Z.AI (GLM), sem alterar as
# configuracoes do comando claude. Uso: zclaude [--setup]
set -euo pipefail

zai_key_file="${ZAI_API_KEY_FILE:-$HOME/.config/zai/api_key}"
zai_api_key="${ZAI_API_KEY:-}"

if [[ ${1:-} == '--setup' ]]; then
  read -r -s -p 'Chave de API da Z.AI: ' zai_api_key
  printf '\n'

  if [[ -z $zai_api_key ]]; then
    printf 'Nenhuma chave foi informada; configuracao cancelada.\n' >&2
    exit 1
  fi

  umask 077
  mkdir -p "$(dirname "$zai_key_file")"
  printf '%s\n' "$zai_api_key" > "$zai_key_file"
  printf 'Chave da Z.AI salva em %s. Agora execute: zclaude\n' "$zai_key_file"
  exit 0
fi

if [[ -z $zai_api_key && -r $zai_key_file ]]; then
  zai_api_key=$(<"$zai_key_file")
fi

if [[ -z $zai_api_key ]]; then
  printf 'Chave da Z.AI nao encontrada. Execute: zclaude --setup\n' >&2
  exit 1
fi

# Resolver antes de exportar a chave: consultas e downloads não precisam dela.
project_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
version_helper="$project_dir/gui/claude_versions.py"
if [[ ! -f $version_helper ]]; then
  version_helper="${XDG_DATA_HOME:-$HOME/.local/share}/devedu.deepin-configs/gui/claude_versions.py"
fi
claude_bin='claude'
managed='external'
if [[ -f $version_helper ]]; then
  resolved=$(/usr/bin/python3 "$version_helper" resolve) || exit 1
  claude_bin=${resolved%$'\n'*}
  managed=${resolved##*$'\n'}
else
  # Compatibilidade com instalações anteriores ao seletor de versões.
  legacy_bin="${ZCLAUDE_CLAUDE_BIN:-$HOME/.local/share/claude-glm/bin/claude}"
  if [[ -x $legacy_bin ]]; then
    claude_bin=$legacy_bin
  fi
fi
if [[ $claude_bin != 'claude' ]]; then
  export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude-glm}"
fi
if [[ $managed == 'managed' ]]; then
  # DeepWin atualiza Stable em diretórios separados; versões fixas ficam intactas.
  export DISABLE_AUTOUPDATER=1
  export DISABLE_UPDATES=1
fi
export ANTHROPIC_AUTH_TOKEN="$zai_api_key"
export ANTHROPIC_BASE_URL='https://api.z.ai/api/anthropic'
export API_TIMEOUT_MS='3000000'
exec "$claude_bin" "$@"
