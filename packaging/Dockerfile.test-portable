FROM linuxdeepin/deepin:beige-25@sha256:cd2314f4214935da3892f3adcb039b4f89a5510169d3208907e62792d7237414
# Somente runtimes do hospedeiro: nenhum .deb do DeepWin, SDK ou compilador.
RUN rm -f /etc/apt/sources.list.d/*.list \
    && printf 'deb https://community-packages.deepin.com/beige crimson main commercial community\n' > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       libdtk6widget qt6-qpa-plugins python3 python3-dbus python3-gi \
       gir1.2-glib-2.0 libx11-6 libxfixes3 xdotool systemd libglib2.0-bin \
       curl file xdg-user-dirs dbus-daemon xz-utils util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/sh portable-test
COPY portable.tar.xz /tmp/portable.tar.xz
COPY verify-portable.sh /tmp/verify-portable.sh
ARG PORTABLE_ROOT
RUN /bin/sh /tmp/verify-portable.sh root "$PORTABLE_ROOT"
